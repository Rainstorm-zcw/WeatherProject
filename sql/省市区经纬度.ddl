
-- 省市经纬度表（取各地级市人民政府驻地，WGS84）
CREATE TABLE IF NOT EXISTS `rh_province_city_lat_lon` (
                                                          `id` BIGINT NOT NULL AUTO_INCREMENT COMMENT '主键ID',
                                                          `name` VARCHAR(64) NOT NULL COMMENT '城市名称',
    `latitude` DECIMAL(10,6) DEFAULT NULL COMMENT '纬度',
    `longitude` DECIMAL(10,6) DEFAULT NULL COMMENT '经度',
    `province` VARCHAR(32) DEFAULT NULL COMMENT '所属省份',
    `status` TINYINT NOT NULL DEFAULT 1 COMMENT '状态：1有效 0无效',
    `create_time` DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    `create_by` VARCHAR(32) DEFAULT 'system' COMMENT '创建人',
    PRIMARY KEY (`id`)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='省市经纬度表';

